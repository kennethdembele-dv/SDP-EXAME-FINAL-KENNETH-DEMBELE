  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PedidoExtracto": {
        "properties": {
          "conta": {
            "type": "string",
            "pattern": "^(EU|US)-\\d{4}$",
            "title": "Conta",
            "examples": [
              "EU-1001"
            ]
          }
        },
        "type": "object",
        "required": [
          "conta"
        ],
        "title": "PedidoExtracto"
      },
      "PedidoTransferencia": {
        "properties": {
          "conta_origem": {
            "type": "string",
            "pattern": "^(EU|US)-\\d{4}$",
            "title": "Conta Origem",
            "examples": [
              "EU-1001"
            ]
          },
          "conta_destino": {
            "type": "string",
            "pattern": "^(EU|US)-\\d{4}$",
            "title": "Conta Destino",
            "examples": [
              "US-2001"
            ]
          },
          "montante": {
            "type": "string",
            "title": "Montante",
            "description": "Texto decimal com ate 2 casas",
            "examples": [
              "125.50"
            ]
          },
          "moeda": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Moeda",
            "default": "EUR"
          }
        },
        "type": "object",
        "required": [
          "conta_origem",
          "conta_destino",
          "montante"
        ],
        "title": "PedidoTransferencia"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
