# Copiar para distribuido/enderecos.env e preencher com os IP reais dos dois computadores
# (ipconfig no Windows, "ip -4 addr" no Linux). O ficheiro e igual nos dois PCs.
IP_PC_A=192.168.1.10
IP_PC_B=192.168.1.20
# Endereco do servidor NFS visto pelo Docker do PC B (normalmente igual a IP_PC_A).
NFS_ENDERECO=192.168.1.10

# Para simular os dois PCs num so computador (ver docs/DOIS_COMPUTADORES.md, "Ensaio num PC"):
# IP_PC_A=host-gateway
# IP_PC_B=host-gateway
# NFS_ENDERECO=127.0.0.1
