# Modelo do .env. O script "python seguranca/gerar_materiais.py" copia-o para .env
# e troca cada valor "trocar" por uma palavra-passe aleatoria. O .env nunca vai para o Git.

# Superutilizador de cada PostgreSQL (so usado dentro do contentor, nos scripts de inicializacao)
PG_SENHA_ADMIN=trocar
# Papel so de leitura: autenticacao e APIs (saldos, historico, utilizadores)
PG_SENHA_LEITURA=trocar
# Papel do coordenador nos nos regionais: debita, credita e prepara transaccoes
PG_SENHA_TRANSACCOES=trocar
# Dono da base do coordenador (registo das decisoes 2PC)
PG_SENHA_COORDENADOR=trocar

# Pontos de pausa para os testes de falha (POST /laboratorio/pausa no coordenador).
# Em producao: LABORATORIO=0
LABORATORIO=1
CHAVE_LABORATORIO=trocar
